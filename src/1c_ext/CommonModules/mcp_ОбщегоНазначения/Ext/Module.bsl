// Преобразует строку в формате JSON в структуру.
// 
// Параметры:
//  СтрокаJSON - Строка - строка в формате JSON.
// 
// Возвращаемое значение:
//  Структура -
Функция JSONВСтруктуру(СтрокаJSON) Экспорт
	// Выделяем в строке JSON часть именно JSON — объект {...} или массив [...],
	// смотря какая открывающая скобка встречается раньше.
	ПозицияФигурной   = СтрНайти(СтрокаJSON, "{");
	ПозицияКвадратной = СтрНайти(СтрокаJSON, "[");

	Если ПозицияФигурной = 0 И ПозицияКвадратной = 0 Тогда
		// Ни объекта, ни массива не найдено
		Возврат Неопределено;
	КонецЕсли;

	Если ПозицияКвадратной = 0
		Или (ПозицияФигурной <> 0 И ПозицияФигурной < ПозицияКвадратной) Тогда
		// Раньше встречается объект — берём от первого "{" до последнего "}"
		ПозицияНачала = ПозицияФигурной;
		ПозицияКонца  = СтрНайти(СтрокаJSON, "}", НаправлениеПоиска.СКонца);
	Иначе
		// Раньше встречается массив — берём от первого "[" до последнего "]"
		ПозицияНачала = ПозицияКвадратной;
		ПозицияКонца  = СтрНайти(СтрокаJSON, "]", НаправлениеПоиска.СКонца);
	КонецЕсли;

	Если ПозицияКонца = 0 Тогда
		// Соответствующая закрывающая скобка не найдена
		Возврат Неопределено;
	КонецЕсли;

	// Вычисляем длину фрагмента: от открывающей до соответствующей закрывающей включительно
	ДлинаФрагмента = ПозицияКонца - ПозицияНачала + 1;

	// Извлекаем корректную часть JSON из строки
	ЧистыйJSON = Сред(СтрокаJSON, ПозицияНачала, ДлинаФрагмента);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ЧистыйJSON);

	Попытка
		// Пытаемся прочитать JSON в структуру
		Результат = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		// Если не удалось, то читаем в соответствие
		ЧтениеJSON.Закрыть();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ЧистыйJSON);

		Соответствие = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();

		// Преобразуем соответствие в структуру с нормализацией ключей
		Возврат СоответствиеВСтруктуруСНормализациейКлючей(Соответствие);
	КонецПопытки;
КонецФункции

// Разбирает URL на составляющие: схема, хост, порт и путь
// 
// Параметры:
//  URL - Строка - URL для разбора
// 
// Возвращаемое значение:
//  Структура - Разобранные части URL (схема, хост, порт, путь)
Функция РазобратьURL(Знач URL) Экспорт
	РезультатРазбора = Новый Структура("Схема, Хост, Порт, Путь");
	    
	    // Проверка и удаление протокола
	    Если НРег(Лев(URL, 8)) = "https://" Тогда
	        РезультатРазбора.Схема = "https";
	        URL = Сред(URL, 9);
	    ИначеЕсли НРег(Лев(URL, 7)) = "http://" Тогда
	        РезультатРазбора.Схема = "http";
	        URL = Сред(URL, 8);
	    Иначе
	        ВызватьИсключение "Неверный формат URL: отсутствует протокол http или https";
	    КонецЕсли;
	    
	    // Разделение хоста, порта и пути
	    ПозицияСлеш = СтрНайти(URL, "/");
	    Если ПозицияСлеш > 0 Тогда
	        ХостИПорт = Лев(URL, ПозицияСлеш - 1);
	        РезультатРазбора.Путь = Сред(URL, ПозицияСлеш);
	    Иначе
	        ХостИПорт = URL;
	        РезультатРазбора.Путь = "/";
	    КонецЕсли;
	    
	    // Разделение хоста и порта
	    ПозицияДвоеточие = СтрНайти(ХостИПорт, ":");
	    Если ПозицияДвоеточие > 0 Тогда
	        РезультатРазбора.Хост = Лев(ХостИПорт, ПозицияДвоеточие - 1);
	        РезультатРазбора.Порт = Число(Сред(ХостИПорт, ПозицияДвоеточие + 1));
	    Иначе
	        РезультатРазбора.Хост = ХостИПорт;
	        РезультатРазбора.Порт = ?(РезультатРазбора.Схема = "https", 443, 80);
	    КонецЕсли;
	    
	    Возврат РезультатРазбора;
КонецФункции

// Сериализует произвольное значение 1С в строку JSON.
// Использует callback ПреобразованиеЗначенияJSON для поддержки типов,
// которые JSON напрямую не поддерживает (ссылки, ТЗ, УИД, списки значений и т.п.).
// Даты сериализуются в формате ISO 8601.
//
// Параметры:
//  Значение - Произвольный - значение для сериализации.
//
// Возвращаемое значение:
//  Строка - JSON-представление значения.
Функция ЗначениеВJSON(Значение) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	НастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;

	ЗаписатьJSON(ЗаписьJSON, Значение, НастройкиСериализации,
		"ПреобразованиеЗначенияJSON", mcp_ОбщегоНазначения);

	Возврат ЗаписьJSON.Закрыть();
КонецФункции

// Преобразует структура в строку JSON.
// Обёртка над ЗначениеВJSON для обратной совместимости.
//
// Параметры:
//  Объект - Структура - которую необходимо преобразовать в строку JSON.
//
// Возвращаемое значение:
//  Строка - в формате JSON.
Функция СтруктураВJSON(Объект) Экспорт
	Возврат ЗначениеВJSON(Объект);
КонецФункции

// Callback для ЗаписатьJSON. Преобразует типы 1С, не поддерживаемые JSON напрямую,
// в JSON-совместимые представления.
//
// Платформа вызывает эту функцию только для значений, которые сама сериализовать не умеет
// (ссылки, УИД, Тип, ОписаниеТипов, ТаблицаЗначений, ДеревоЗначений, СписокЗначений,
// ХранилищеЗначения и т.п.).
//
// Подключается параметром ИмяФункцииПреобразования метода ЗаписатьJSON.
//
// Параметры:
//  Свойство     - Строка       - имя свойства объекта (пусто для элементов массива).
//  Значение     - Произвольный - значение, которое платформа не смогла записать.
//  ДопПараметры - Произвольный - параметры, переданные в ЗаписатьJSON.
//  Отказ        - Булево       - установить в Истина, чтобы свойство не записывалось.
//
// Возвращаемое значение:
//  Произвольный - JSON-совместимое значение для записи (или значение другого неподдерживаемого
//                 типа — тогда платформа вызовет callback повторно для него).
Функция ПреобразованиеЗначенияJSON(Свойство, Значение, ДопПараметры, Отказ) Экспорт

	ТипЗначения = ТипЗнч(Значение);

	// Хранилище значения — заглушка без payload
	Если ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат "<ХранилищеЗначения>";
	КонецЕсли;

	// Таблица значений → массив структур (ключи = имена колонок)
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат ТаблицаЗначенийВМассив(Значение);
	КонецЕсли;

	// Дерево значений → массив структур с вложенным ключом "Строки"
	Если ТипЗначения = Тип("ДеревоЗначений") Тогда
		Возврат СтрокиДереваВМассив(Значение.Строки, Значение.Колонки);
	КонецЕсли;

	// Список значений → массив структур {value, presentation}
	Если ТипЗначения = Тип("СписокЗначений") Тогда
		Возврат СписокЗначенийВМассив(Значение);
	КонецЕсли;

	// Остальное (ссылки, пустые ссылки, УИД, Тип, ОписаниеТипов, перечисления, неизвестные типы)
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, является ли символ буквой.
//
// Параметры:
//  Символ - Строка - символ для проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если символ является буквой.
Функция ЭтоБуква(Символ)

	КодСимвола = КодСимвола(Символ);

	// Латинские буквы A-Z (65-90) и a-z (97-122)
	Если (КодСимвола >= 65 И КодСимвола <= 90)
		Или (КодСимвола >= 97 И КодСимвола <= 122) Тогда
		Возврат Истина;
	КонецЕсли;

	// Кириллические буквы А-Я (1040-1103), включая Ё (1025, 1105)
	Если (КодСимвола >= 1040 И КодСимвола <= 1103)
		Или КодСимвола = 1025
		Или КодСимвола = 1105 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверяет, является ли символ цифрой.
//
// Параметры:
//  Символ - Строка - символ для проверки.
//
// Возвращаемое значение:
//  Булево - Истина, если символ является цифрой.
Функция ЭтоЦифра(Символ)

	КодСимвола = КодСимвола(Символ);

	// Цифры 0-9 (48-57)
	Возврат КодСимвола >= 48 И КодСимвола <= 57;

КонецФункции

// Нормализует ключ для использования в структуре.
// Заменяет недопустимые символы на "_" и обеспечивает,
// что первый символ - буква или "_".
//
// Параметры:
//  Ключ - Строка - исходный ключ.
//
// Возвращаемое значение:
//  Строка - нормализованный ключ.
Функция НормализоватьКлюч(Ключ)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат "_";
	КонецЕсли;

	НормализованныйКлюч = "";

	Для Индекс = 1 По СтрДлина(Ключ) Цикл
		Символ = Сред(Ключ, Индекс, 1);

		Если Индекс = 1 Тогда
			// Первый символ должен быть буквой или "_"
			Если ЭтоБуква(Символ) Или Символ = "_" Тогда
				НормализованныйКлюч = НормализованныйКлюч + Символ;
			Иначе
				НормализованныйКлюч = НормализованныйКлюч + "_";
			КонецЕсли;
		Иначе
			// Последующие символы могут быть буквами, цифрами или "_"
			Если ЭтоБуква(Символ) Или ЭтоЦифра(Символ) Или Символ = "_" Тогда
				НормализованныйКлюч = НормализованныйКлюч + Символ;
			Иначе
				НормализованныйКлюч = НормализованныйКлюч + "_";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат НормализованныйКлюч;

КонецФункции

// Преобразует таблицу значений в массив структур для последующей сериализации в JSON.
// Ключи структур — имена колонок ТЗ.
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - исходная таблица.
//
// Возвращаемое значение:
//  Массив - массив структур, по одной на строку ТЗ.
Функция ТаблицаЗначенийВМассив(ТаблицаЗначений)

	Результат = Новый Массив;

	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
		СтруктураСтроки = Новый Структура;
		Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
			СтруктураСтроки.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		КонецЦикла;
		Результат.Добавить(СтруктураСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рекурсивно преобразует коллекцию строк дерева значений в массив структур.
// При наличии дочерних строк добавляет к структуре ключ "Строки".
//
// Параметры:
//  СтрокиДерева - КоллекцияСтрокДереваЗначений - строки дерева или поддерева.
//  Колонки      - КолонкиДереваЗначений        - колонки исходного дерева.
//
// Возвращаемое значение:
//  Массив - массив структур.
Функция СтрокиДереваВМассив(СтрокиДерева, Колонки)

	Результат = Новый Массив;

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		СтруктураСтроки = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтруктураСтроки.Вставить(Колонка.Имя, СтрокаДерева[Колонка.Имя]);
		КонецЦикла;
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СтруктураСтроки.Вставить("Строки", СтрокиДереваВМассив(СтрокаДерева.Строки, Колонки));
		КонецЕсли;
		Результат.Добавить(СтруктураСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует список значений в массив структур {value, presentation}.
//
// Параметры:
//  СписокЗначений - СписокЗначений - исходный список.
//
// Возвращаемое значение:
//  Массив - массив структур.
Функция СписокЗначенийВМассив(СписокЗначений)

	Результат = Новый Массив;

	Для Каждого Элемент Из СписокЗначений Цикл
		СтруктураЭлемента = Новый Структура;
		СтруктураЭлемента.Вставить("value", Элемент.Значение);
		СтруктураЭлемента.Вставить("presentation", Элемент.Представление);
		Результат.Добавить(СтруктураЭлемента);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует соответствие в структуру с нормализацией ключей.
// Рекурсивно обрабатывает вложенные объекты.
//
// Параметры:
//  Значение - Произвольный - значение для преобразования.
//
// Возвращаемое значение:
//  Произвольный - преобразованное значение.
Функция СоответствиеВСтруктуруСНормализациейКлючей(Значение)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда

		Структура = Новый Структура;

		Для Каждого КлючЗначение Из Значение Цикл

			НормализованныйКлюч = НормализоватьКлюч(Строка(КлючЗначение.Ключ));

			// Рекурсивно обрабатываем значение
			ОбработанноеЗначение = СоответствиеВСтруктуруСНормализациейКлючей(КлючЗначение.Значение);

			Структура.Вставить(НормализованныйКлюч, ОбработанноеЗначение);

		КонецЦикла;

		Возврат Структура;

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда

		Массив = Новый Массив;

		Для Каждого Элемент Из Значение Цикл
			// Рекурсивно обрабатываем элементы массива
			Массив.Добавить(СоответствиеВСтруктуруСНормализациейКлючей(Элемент));
		КонецЦикла;

		Возврат Массив;

	Иначе

		// Простое значение - возвращаем как есть
		Возврат Значение;

	КонецЕсли;

КонецФункции

#КонецОбласти

