#Область Переменные

Перем ЯзыкСинтаксиса;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сформировать текстовое описание структуры объекта метаданных.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных, структуру которого нужно вывести.
//  Секции - Массив из Строка - имена секций для вывода:
//                              "fields", "tabular_sections", "predefined", "owners",
//                              "register_records" (регистры движений документа),
//                              "subsystems" (подсистемы прямого вхождения).
//                              Если Неопределено - выводятся все применимые секции, кроме "predefined" и "subsystems".
//                              Для перечислений учитывается только "subsystems"
//                              (остальные секции игнорируются, выводится состав значений).
//  МаксТиповВСоставном - Число - лимит на количество типов составного реквизита (0 - без лимита).
//
// Возвращаемое значение:
//  Строка - многострочное текстовое описание.
//
Функция ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта, Секции = Неопределено, МаксТиповВСоставном = 10) Экспорт

	ЯзыкСинтаксиса = ?(
		Метаданные.ВариантВстроенногоЯзыка = Метаданные.СвойстваОбъектов.ВариантВстроенногоЯзыка.Английский,
		"en",
		"ru");

	МассивСтрок = Новый Массив;

	// Заголовок объекта
	МетаТип = СтрРазделить(МетаданныеОбъекта.ПолноеИмя(), ".")[0];
	ВывестиЗаголовокОбъектаМетаданных(МассивСтрок, МетаданныеОбъекта, МетаТип);

	// Секция "subsystems" — до раннего возврата для перечислений, чтобы работала для любых типов
	Если ВключитьСекцию("subsystems", Секции) Тогда
		ВывестиПодсистемыОбъекта(МассивСтрок, МетаданныеОбъекта);
	КонецЕсли;

	// Перечисления: остальные секции не применяются, выводится только состав значений
	Если Метаданные.Перечисления.Содержит(МетаданныеОбъекта) Тогда
		ВывестиЗначенияПеречисления(МассивСтрок, МетаданныеОбъекта);
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;

	ЭтоРегистр = ЭтоРегистрМД(МетаданныеОбъекта);

	// Секция "fields": стандартные реквизиты, измерения/ресурсы (для регистров), реквизиты
	Если ВключитьСекцию("fields", Секции) Тогда
		СтандартныеРеквизиты = ПолучитьСвойствоМД(МетаданныеОбъекта, "СтандартныеРеквизиты");
		Если СтандартныеРеквизиты <> Неопределено Тогда
			ВывестиСписокРеквизитовМетаданных(
				МассивСтрок,
				СтандартныеРеквизиты,
				НСтр("ru='Стандартные реквизиты';en='Standard attributes'"),
				МаксТиповВСоставном);
		КонецЕсли;

		Если ЭтоРегистр Тогда
			Измерения = ПолучитьСвойствоМД(МетаданныеОбъекта, "Измерения");
			Если Измерения <> Неопределено Тогда
				ВывестиСписокРеквизитовМетаданных(
					МассивСтрок,
					Измерения,
					НСтр("ru='Измерения';en='Dimensions'"),
					МаксТиповВСоставном);
			КонецЕсли;
			Ресурсы = ПолучитьСвойствоМД(МетаданныеОбъекта, "Ресурсы");
			Если Ресурсы <> Неопределено Тогда
				ВывестиСписокРеквизитовМетаданных(
					МассивСтрок,
					Ресурсы,
					НСтр("ru='Ресурсы';en='Resources'"),
					МаксТиповВСоставном);
			КонецЕсли;
		КонецЕсли;

		Реквизиты = ПолучитьСвойствоМД(МетаданныеОбъекта, "Реквизиты");
		Если Реквизиты <> Неопределено Тогда
			ВывестиСписокРеквизитовМетаданных(
				МассивСтрок,
				Реквизиты,
				НСтр("ru='Реквизиты';en='Attributes'"),
				МаксТиповВСоставном);
		КонецЕсли;
	КонецЕсли;

	// Секция "owners" (только для справочников)
	Если ВключитьСекцию("owners", Секции)
		И Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		И МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
		ВывестиВладельцевМетаданных(МассивСтрок, МетаданныеОбъекта);
	КонецЕсли;

	// Секция "tabular_sections" (для не-регистров)
	Если ВключитьСекцию("tabular_sections", Секции) И Не ЭтоРегистр Тогда
		ТабличныеЧасти = ПолучитьСвойствоМД(МетаданныеОбъекта, "ТабличныеЧасти");
		Если ТабличныеЧасти <> Неопределено Тогда
			ВывестиТабличныеЧастиМетаданных(МассивСтрок, ТабличныеЧасти, МаксТиповВСоставном);
		КонецЕсли;
	КонецЕсли;

	// Секция "register_records" — регистры движений документа (гард по типу — внутри хелпера)
	Если ВключитьСекцию("register_records", Секции) Тогда
		ВывестиДвиженияРегистров(МассивСтрок, МетаданныеОбъекта);
	КонецЕсли;

	// Секция "predefined" (по умолчанию не выводится)
	Если ВключитьСекцию("predefined", Секции)
		И ОбъектПоддерживаетПредопределенные(МетаданныеОбъекта) Тогда
		ВывестиПредопределенныеМетаданных(МассивСтрок, МетаданныеОбъекта);
	КонецЕсли;

	// Объединяем строки через символ перевода строки
	Результат = СтрСоединить(МассивСтрок, Символы.ПС);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнструментСтруктураОбъекта

// Безопасное получение значения свойства объекта метаданных.
// Если свойство отсутствует у данного типа объекта - возвращает Неопределено.
//
Функция ПолучитьСвойствоМД(МетаданныеОбъекта, ИмяСвойства)

	Обёртка = Новый Структура(ИмяСвойства);
	ЗаполнитьЗначенияСвойств(Обёртка, МетаданныеОбъекта);
	Возврат Обёртка[ИмяСвойства];

КонецФункции

// Проверка, нужно ли выводить секцию.
// Если Секции = Неопределено - выводятся все, кроме "predefined" и "subsystems".
// Если Секции заданы - выводятся только перечисленные.
//
Функция ВключитьСекцию(ИмяСекции, Секции)

	Если Секции = Неопределено Тогда
		Возврат ИмяСекции <> "predefined" И ИмяСекции <> "subsystems";
	КонецЕсли;
	Возврат Секции.Найти(ИмяСекции) <> Неопределено;

КонецФункции

Функция ОбъектПоддерживаетПредопределенные(МетаданныеОбъекта)

	Возврат Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.ПланыСчетов.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.ПланыВидовРасчета.Содержит(МетаданныеОбъекта);

КонецФункции

Функция ЭтоРегистрМД(МетаданныеОбъекта)

	Возврат Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыНакопления.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыРасчета.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта);

КонецФункции

Функция ПолучитьСтрокуТипаМетаданных(ТипРеквизита, МаксТипов = 10)

	МассивСтрокТипов = Новый Массив;
	Типы = ТипРеквизита.Типы();
	ОбщееКоличество = Типы.Количество();
	ВыведеноТипов = 0;

	Для Каждого Тип Из Типы Цикл

		Если МаксТипов > 0 И ВыведеноТипов >= МаксТипов Тогда
			Остаток = ОбщееКоличество - ВыведеноТипов;
			МассивСтрокТипов.Добавить(
				"... (" + НСтр("ru='ещё';en='more'") + " "
				+ Остаток + " " + НСтр("ru='типов';en='types'") + ")");
			Прервать;
		КонецЕсли;

		ТипМД = Метаданные.НайтиПоТипу(Тип);

		Если ТипМД = Неопределено Тогда
			МассивСтрокТипов.Добавить(Строка(Тип));
		Иначе
			СтрокаТипа = ТипМД.ПолноеИмя();

			Если Метаданные.Перечисления.Содержит(ТипМД) Тогда
				ЛимитЗначений = 10;
				ВсегоЗначений = ТипМД.ЗначенияПеречисления.Количество();
				МассивЗначений = Новый Массив;
				Счетчик = 0;
				Для Каждого ЗначениеПеречисления Из ТипМД.ЗначенияПеречисления Цикл
					Если Счетчик < ЛимитЗначений Тогда
						МассивЗначений.Добавить(ЗначениеПеречисления.Имя);
						Счетчик = Счетчик + 1;
					Иначе
						ОстатокЗначений = ВсегоЗначений - ЛимитЗначений;
						МассивЗначений.Добавить(
							"... (" + НСтр("ru='ещё';en='more'") + " "
							+ ОстатокЗначений + " " + НСтр("ru='значений';en='values'") + ")");
						Прервать;
					КонецЕсли;
				КонецЦикла;

				Если МассивЗначений.Количество() > 0 Тогда
					СтрокаЗначений = СтрСоединить(МассивЗначений, ", ");
					СтрокаТипа = СтрокаТипа + " (" + СтрокаЗначений + ")";
				КонецЕсли;
			КонецЕсли;
			МассивСтрокТипов.Добавить(СтрокаТипа);
		КонецЕсли;
		ВыведеноТипов = ВыведеноТипов + 1;
	КонецЦикла;

	Возврат СтрСоединить(МассивСтрокТипов, ", ");

КонецФункции

Процедура ВывестиЗаголовокОбъектаМетаданных(МассивСтрок, МетаданныеОбъекта, МетаТип)

	МассивСтрок.Добавить(НСтр("ru='Структура объекта ';en='Object structure '") + МетаТип + "." + МетаданныеОбъекта.Имя + ":");
	МассивСтрок.Добавить(НСтр("ru='Синоним: ';en='Synonym: '") + """" + МетаданныеОбъекта.Синоним + """");
	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиСписокРеквизитовМетаданных(МассивСтрок, Реквизиты, ИмяРаздела, МаксТиповВСоставном = 10)

	Если Реквизиты.Количество() > 0 Тогда
		МассивСтрок.Добавить(ИмяРаздела + ":");

		Для каждого Реквизит Из Реквизиты Цикл
			ТипРекв_Стр = ПолучитьСтрокуТипаМетаданных(Реквизит.Тип, МаксТиповВСоставном);
			МассивСтрок.Добавить(Символы.Таб + Реквизит.Имя + " - " + ТипРекв_Стр + " - """ + Реквизит.Синоним + """");
		КонецЦикла;

		МассивСтрок.Добавить("");
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиТабличныеЧастиМетаданных(МассивСтрок, ТабличныеЧасти, МаксТиповВСоставном = 10)

	Если ТабличныеЧасти.Количество() > 0 Тогда
		МассивСтрок.Добавить(НСтр("ru='Табличные части:';en='Tabular sections:'"));

		Для каждого ТабЧасть Из ТабличныеЧасти Цикл
			МассивСтрок.Добавить(Символы.Таб + НСтр("ru='ТЧ ';en='TS '") + """" + ТабЧасть.Имя + """ - """ + ТабЧасть.Синоним + """:");

			Для каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				ТипРекв_Стр = ПолучитьСтрокуТипаМетаданных(Реквизит.Тип, МаксТиповВСоставном);
				МассивСтрок.Добавить(Символы.Таб + Символы.Таб + Реквизит.Имя + " - " + ТипРекв_Стр + " - """ + Реквизит.Синоним + """");
			КонецЦикла;
		КонецЦикла;

		МассивСтрок.Добавить("");
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиВладельцевМетаданных(МассивСтрок, МетаданныеОбъекта)

	МассивСтрок.Добавить(НСтр("ru='Владельцы:';en='Owners:'"));

	Для каждого Владелец Из МетаданныеОбъекта.Владельцы Цикл
		МассивСтрок.Добавить(Символы.Таб + Владелец.ПолноеИмя());
	КонецЦикла;

	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиЗначенияПеречисления(МассивСтрок, МетаданныеПеречисления)

	Если МетаданныеПеречисления.ЗначенияПеречисления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСтрок.Добавить(НСтр("ru='Значения перечисления:';en='Enum values:'"));

	Для каждого Значение Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
		МассивСтрок.Добавить(Символы.Таб + Значение.Имя + " - """ + Значение.Синоним + """");
	КонецЦикла;

	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиПредопределенныеМетаданных(МассивСтрок, МетаданныеОбъекта)

	ИменаПредопределенных = МетаданныеОбъекта.ПолучитьИменаПредопределенных();
	Если ИменаПредопределенных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСтрок.Добавить(НСтр("ru='Предопределённые:';en='Predefined:'"));

	Для каждого Имя Из ИменаПредопределенных Цикл
		МассивСтрок.Добавить(Символы.Таб + Имя);
	КонецЦикла;

	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиДвиженияРегистров(МассивСтрок, МетаданныеОбъекта)

	// Блок применим только к документам
	Если Не Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;

	Если МетаданныеОбъекта.Движения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСтрок.Добавить(НСтр("ru='Движения по регистрам:';en='Register records:'"));

	Для каждого РегистрМД Из МетаданныеОбъекта.Движения Цикл
		МассивСтрок.Добавить(Символы.Таб + РегистрМД.ПолноеИмя());
	КонецЦикла;

	МассивСтрок.Добавить("");

КонецПроцедуры

Процедура ВывестиПодсистемыОбъекта(МассивСтрок, МетаданныеОбъекта)

	НайденныеПодсистемы = Новый Массив;
	СобратьПодсистемыСодержащиеОбъект(Метаданные.Подсистемы, МетаданныеОбъекта, НайденныеПодсистемы);

	Если НайденныеПодсистемы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МассивСтрок.Добавить(НСтр("ru='Подсистемы:';en='Subsystems:'"));

	Для каждого Подсистема Из НайденныеПодсистемы Цикл
		МассивСтрок.Добавить(Символы.Таб + Подсистема.ПолноеИмя());
	КонецЦикла;

	МассивСтрок.Добавить("");

КонецПроцедуры

// Рекурсивный обход дерева подсистем. Только прямое вхождение через Состав подсистемы.
//
Процедура СобратьПодсистемыСодержащиеОбъект(КоллекцияПодсистем, МетаданныеОбъекта, Результат)

	Для каждого Подсистема Из КоллекцияПодсистем Цикл
		Если Подсистема.Состав.Содержит(МетаданныеОбъекта) Тогда
			Результат.Добавить(Подсистема);
		КонецЕсли;
		Если Подсистема.Подсистемы.Количество() > 0 Тогда
			СобратьПодсистемыСодержащиеОбъект(Подсистема.Подсистемы, МетаданныеОбъекта, Результат);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
